# Servidor HTTP
PORT=3333
NODE_ENV=development
API_BASE_URL=http://localhost:3333

# Banco de Dados (Prisma ORM - SQLite local por padrão)
DATABASE_URL="file:./data/pays.db"

# Autenticação do Painel Administrativo
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
JWT_SECRET=cjc_dev_pays_super_secret_jwt_token_2026

# Mercado Pago - Credenciais Oficiais
# Obtenha em: https://www.mercadopago.com.br/developers/panel/app
MP_ACCESS_TOKEN=APP_USR-seu-access-token-aqui
MP_PUBLIC_KEY=APP_USR-sua-public-key-aqui
MP_WEBHOOK_SECRET=seu-webhook-secret-aqui
MP_SANDBOX=false

# Configurações de Fila de Webhooks (Fan-Out)
WEBHOOK_MAX_RETRIES=5
WEBHOOK_RETRY_INTERVAL_SECONDS=60
